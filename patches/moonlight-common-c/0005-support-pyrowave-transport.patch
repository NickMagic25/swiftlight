+int sf_common_select_pyrowave_format(uint32_t serverFormats, uint32_t clientFormats) {
+    static const uint32_t serverProfiles[] = { SCM_PYROWAVE_HDR10_444, SCM_PYROWAVE_HDR10, SCM_PYROWAVE_444, SCM_PYROWAVE };
+    static const uint32_t clientProfiles[] = { VIDEO_FORMAT_PYROWAVE_HDR10_444, VIDEO_FORMAT_PYROWAVE_HDR10,
+                                             VIDEO_FORMAT_PYROWAVE_444, VIDEO_FORMAT_PYROWAVE };
+    for (unsigned int i = 0; i < sizeof(serverProfiles) / sizeof(serverProfiles[0]); ++i) {
+        if ((serverFormats & serverProfiles[i]) && (clientFormats & clientProfiles[i])) {
+            return (int)clientProfiles[i];
