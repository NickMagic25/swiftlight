 // SDP attributes are in the form:
 // a=x-nv-bwe.bwuSafeZoneLowLimit:70\r\n
+// Copies a token-valued SDP attribute (up to whitespace) into val
+static bool parseSdpAttributeToToken(const char* payload, const char* name, char* val, size_t valSize) {
+    size_t nameLength = strlen(name);
+    for (const char* line = payload; line != NULL && *line != '\0'; ) {
+        const char* next = strchr(line, '\n');
+        size_t lineLength = next ? (size_t)(next - line) : strlen(line);
+        if (lineLength > nameLength + 3 && strncmp(line, "a=", 2) == 0 &&
+                strncmp(line + 2, name, nameLength) == 0 && line[2 + nameLength] == ':') {
+            const char* token = line + 3 + nameLength;
+            size_t tokenLength = strcspn(token, " \t\r\n");
+            if (tokenLength == 0 || valSize == 0) {
+                return false;
+            }
+            if (tokenLength >= valSize) tokenLength = valSize - 1;
+            memcpy(val, token, tokenLength);
+            val[tokenLength] = '\0';
+            return true;
+        }
+        line = next ? next + 1 : NULL;
+    }
+    return false;
+}
+
+// A missing revision permits older hosts; an explicit incompatible revision is
+// rejected because PyroWave records have no independent bitstream version field.
+bool sf_common_pyrowave_bitstream_compatible(const char* sdp) {
+    char bitstreamId[32] = {0};
+    parseSdpAttributeToToken(sdp, "x-ss-pyrowave.bitstream", bitstreamId, sizeof(bitstreamId));
+    return bitstreamId[0] == '\0' || strcmp(bitstreamId, PYROWAVE_BITSTREAM_ID) == 0;
+}
+
+const char* LiGetHostPyroWaveBitstreamId(void) {
