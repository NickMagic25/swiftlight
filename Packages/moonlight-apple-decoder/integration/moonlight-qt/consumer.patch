diff --git a/app/streaming/video/ffmpeg_videosamples.cpp b/app/streaming/video/ffmpeg_videosamples.cpp
index d2552396..e25a6ff6 100644
--- a/app/streaming/video/ffmpeg_videosamples.cpp
+++ b/app/streaming/video/ffmpeg_videosamples.cpp
@@ -1,5 +1,9 @@
 #include "ffmpeg.h"
 
+// The native adapter uses the same samples to check each codec/bit-depth variant.
+// AV1 arrays carry FFmpeg input padding after the final sized OBU. Real common-c
+// access units have already had transport padding removed by VideoDepacketizer.
+
 // NOTE: All test frames MUST be 720p in order for us to provide the correct dimensions in the AVCodecContext!
 // See FFmpegVideoDecoder::tryInitializeRenderer() for details.
 
@@ -168,3 +172,37 @@ const uint8_t FFmpegVideoDecoder::k_AV1High10_444TestFrame[] = {
   0x81, 0x37, 0x40, 0xfd, 0x19, 0x97, 0xdc, 0x15, 0x72, 0x1d, 0xe0, 0xff,
   0x00, 0x35, 0x9d, 0x2c, 0x10, 0x7d, 0x17, 0x58, 0x60,
 };
+
+bool FFmpegVideoDecoder::getNativeProbeSample(int format, const uint8_t** data, size_t* size)
+{
+    if (!data || !size) return false;
+    switch (format) {
+    case VIDEO_FORMAT_H265: *data = k_HEVCMainTestFrame; *size = sizeof(k_HEVCMainTestFrame); break;
+    case VIDEO_FORMAT_H265_MAIN10: *data = k_HEVCMain10TestFrame; *size = sizeof(k_HEVCMain10TestFrame); break;
+    case VIDEO_FORMAT_AV1_MAIN8: *data = k_AV1Main8TestFrame; *size = sizeof(k_AV1Main8TestFrame); break;
+    case VIDEO_FORMAT_AV1_MAIN10: *data = k_AV1Main10TestFrame; *size = sizeof(k_AV1Main10TestFrame); break;
+    default: return false;
+    }
+    if (format & VIDEO_FORMAT_MASK_AV1) {
+        size_t offset = 0;
+        while (offset < *size && (*data)[offset] != 0) {
+            uint8_t header = (*data)[offset++];
+            if (!(header & 2) || (header & 0x81)) return false;
+            if (header & 4) { if (offset == *size) return false; ++offset; }
+            size_t length = 0;
+            unsigned shift = 0;
+            uint8_t byte;
+            do {
+                if (offset == *size || shift > 49) return false;
+                byte = (*data)[offset++];
+                length |= size_t(byte & 127) << shift;
+                shift += 7;
+            } while (byte & 128);
+            if (length > *size - offset) return false;
+            offset += length;
+        }
+        for (size_t i = offset; i < *size; ++i) if ((*data)[i]) return false;
+        *size = offset;
+    }
+    return true;
+}
